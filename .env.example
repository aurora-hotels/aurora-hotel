# Node.js 24. npm run setup generuje lokalne sekrety i hasło administratora.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/aurora.sqlite
SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@aurora.local
ADMIN_PASSWORD=
# Adresy rzeczywistych API wpisz dopiero po uzgodnieniu z grupami.
ALLOWED_PARTNER_HOSTS=
