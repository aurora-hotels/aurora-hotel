# Node.js 24. npm run setup generuje lokalne sekrety i hasło administratora.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/aurora.sqlite
SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@aurora.local
ADMIN_PASSWORD=
# Adresy rzeczywistych API wpisz dopiero po uzgodnieniu z grupami.
ALLOWED_PARTNER_HOSTS=
# Tylko do uzgodnionej integracji w sieci lokalnej; wymaga też wpisu powyżej.
ALLOW_PRIVATE_PARTNER_HOSTS=
# Docker udostępnia klienta i API pod jednym adresem.
DOCKER_APP_ORIGIN=http://localhost:3001
# Dodatkowe ustawienia; domyślne wartości zwykle wystarczają.
HOST=127.0.0.1
SESSION_HOURS=12
PASSWORD_MIN_LENGTH=10
MAX_STAY_NIGHTS=90
LOGIN_RATE_LIMIT=15
PUBLIC_RATE_LIMIT=300
# Dla publicznego HTTPS ustaw true. Lokalny HTTP wymaga false.
COOKIE_SECURE=false
