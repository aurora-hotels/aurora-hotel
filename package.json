{
  "name": "aurora-hotels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "seed": "tsx backend/src/seed.ts",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts && tsc -p backend/tsconfig.json",
    "start": "node --env-file=.env backend/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "backup": "node --env-file=.env scripts/backup.mjs"
  },
  "dependencies": {
    "express": "^5.3.0", "zod": "^4.1.0", "dotenv": "^17.2.0",
    "helmet": "^8.1.0", "express-rate-limit": "^8.1.0", "cookie-parser": "^1.4.7",
    "react": "^19.2.0", "react-dom": "^19.2.0", "react-router-dom": "^7.9.0",
    "lucide-react": "^0.468.0", "luxon": "^3.7.0", "swagger-ui-express": "^5.0.1", "yaml": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0", "tsx": "^4.20.0", "vite": "^7.2.0", "@vitejs/plugin-react": "^5.0.0",
    "vitest": "^3.2.4", "supertest": "^7.1.0", "@playwright/test": "^1.56.0", "concurrently": "^9.2.0",
    "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "@types/express": "^5.0.0", "@types/cookie-parser": "^1.4.9", "@types/supertest": "^6.0.3", "@types/luxon": "^3.7.0", "@types/swagger-ui-express": "^4.1.8"
  }
}
